#!/usr/bin/env ruby
# Checks every translation in locales/ against reference/admin.en.yml.
#
#   bin/check           all languages
#   bin/check fr        one language
#   bin/check fr --missing   also list the keys not translated yet
#
# Exits non-zero if any file has an error. Untranslated keys are reported as
# coverage only: the application shows English for them.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'broadcast_i18n'
require 'broadcast_i18n/check'

list_missing = ARGV.delete('--missing')
locales = ARGV.empty? ? BroadcastI18n::LOCALES.keys : ARGV
failed = false

locales.each do |locale|
  file = BroadcastI18n.locale_file(locale)
  unless File.exist?(file)
    puts "#{locale}: #{File.basename(file)} not found"
    failed = true
    next
  end

  result = BroadcastI18n::Check.new(reference: BroadcastI18n.reference_file, file:, locale:).run
  puts format('%-3s %6.1f%% translated, %d missing, %d errors', locale, result.coverage, result.missing.size, result.errors.size)
  result.errors.each { |error| puts "    #{error}" }
  result.missing.each { |key| puts "    missing: #{key}" } if list_missing
  failed ||= result.errors.any?
end

exit(failed ? 1 : 0)
